APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+psycopg://meroguru:change-me@postgres:5432/meroguru
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Master key used to encrypt user-supplied provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me

# Default/fallback AI provider when a user has not configured their own key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional deployment-level fallback keys (admin scope). Leave blank for pure BYOK.
YOUTUBE_API_KEY=
ALLOW_REMOTE_MODELS=true
TELEMETRY_ENABLED=false

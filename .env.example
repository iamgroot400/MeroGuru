APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Used by both the postgres container and the api/worker connection string.
# Change this before exposing the stack anywhere beyond your own machine.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://meroguru:change-me@postgres:5432/meroguru
REDIS_URL=redis://redis:6379/0

# Master key used to encrypt user-supplied provider API keys at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me

# Default/fallback AI provider when a user has not configured their own key.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Optional deployment-level fallback keys (admin scope). Leave blank for pure BYOK.
YOUTUBE_API_KEY=
ALLOW_REMOTE_MODELS=true
TELEMETRY_ENABLED=false

# Brain service: the stateless adaptation-engine/analytics microservice that
# apps/api (the orchestrator) calls over HTTP. Falls back to local computation
# if unreachable, but should point at the real service in normal operation.
BRAIN_BASE_URL=http://brain:8100
# Shared secret the api/worker present to the brain. The brain refuses every
# request when this is empty, because it makes outbound calls using the
# provider config in the request body.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRAIN_SHARED_SECRET=change-me-too

# Origin allowed to call the API. The API has no login, so this allowlist is
# what stops an arbitrary page you visit from reading your data.
# CORS_EXTRA_ORIGINS=http://192.168.1.10:3000

# Per-client ceilings (the API is unauthenticated by design).
RATE_LIMIT_PER_MINUTE=120
PLAN_GENERATION_RATE_LIMIT_PER_HOUR=12

# Allow provider base_urls that resolve to private/loopback addresses for
# remote providers too. Off by default: this re-enables SSRF reach.
# MEROGURU_ALLOW_PRIVATE_PROVIDER_URLS=false
